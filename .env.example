# Local PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/developer_network
DB_USERNAME=your_local_db_username
DB_PASSWORD=your_local_db_password

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLOUD_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application
APP_SECRET_KEY=your_long_random_secret
PORT=8080
SHOW_SQL=true

# Frontend
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect
CORS_ALLOWED_ORIGINS=http://localhost:5173